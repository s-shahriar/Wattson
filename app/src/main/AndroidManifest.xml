<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Wattson reads battery stats on demand only, while you are looking at it.
      Deliberately absent:
        * no <service> / <receiver>              -> nothing can be started in the background
        * no RECEIVE_BOOT_COMPLETED              -> never auto-starts
        * no FOREGROUND_SERVICE / WAKE_LOCK      -> cannot hold the CPU awake

      INTERNET is used for exactly one thing: the manual "Check for updates" button,
      which fetches the GitHub releases feed. Nothing is sent, and no request is made
      unless you press it. Battery data never leaves the device.
    -->
    <!--
      Both are declared so they can be granted over adb on non-rooted devices:
        adb shell pm grant com.syed.wattson android.permission.DUMP
        adb shell pm grant com.syed.wattson android.permission.BATTERY_STATS

      DUMP alone is not enough: it lets the app invoke dumpsys, but the batterystats
      service performs its own BATTERY_STATS check on the caller. Both are
      development-level, so neither is ever auto-granted — without them, and without
      root, the app simply runs in its basic tier.
    -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />
    <!--
      BatteryStatsService's dump handler checks this one too. It is appop-level, so
      unlike the other two it can be granted on the device itself via
      Settings > Special app access > Usage access.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Turns a uid into an app name for the Diagnose tab.

      The battery history blames a window on uids, not names: "u0a313 held the phone
      awake for seventeen minutes". Since Android 11 an app cannot see another package
      unless it says which ones it wants, and there is no way to name in advance the set
      of apps that might be draining a battery — so it has to be all of them.

      It grants no ability to read anything from those apps. It is a lookup from a number
      to a label, done on the device, only while a report is on screen, and no part of it
      leaves the phone. Without it every row on that tab reads "uid 10313".
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wattson">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wattson">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the downloaded APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
